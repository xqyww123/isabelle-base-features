#!/usr/bin/env bash
# Write <golden dir>/METADATA after a feature's golden sessions were recorded on its stock tree:
# the tree and its ISABELLE_IDENTIFIER, the commit it is detached at, its git status (must be
# empty), and the sha256 of every golden file.
# Usage: record-golden-metadata <golden dir> <stock tree>
set -euo pipefail
[[ $# -eq 2 ]] || { echo "usage: record-golden-metadata <golden dir> <stock tree>" >&2; exit 2; }
golden=$(cd "$1" && pwd)
tree=$(cd "$2" && pwd)
id=$(cat "$tree/etc/ISABELLE_IDENTIFIER")
[[ $id == *-stock ]] ||
  { echo "ERROR: $tree is not a stock tree (ISABELLE_IDENTIFIER=$id)" >&2; exit 1; }
status=$(git -C "$tree" status --porcelain --untracked-files=all)
[[ -z $status ]] ||
  { echo "ERROR: $tree has uncommitted changes:" >&2; echo "$status" >&2; exit 1; }
commit=$(git -C "$tree" rev-parse HEAD)
subject=$(git -C "$tree" log -1 --format=%s)
{
  echo "recorded: $(date -Is)"
  echo "tree: $tree (ISABELLE_IDENTIFIER=$id)"
  echo "commit: $commit ($subject)"
  echo "git status: empty"
  echo "sha256:"
  (cd "$golden" && sha256sum ./*.golden) | sed 's/^/  /'
} > "$golden/METADATA"
cat "$golden/METADATA"
